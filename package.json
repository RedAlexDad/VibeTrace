    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-tooltip": "^5.30.0",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.12.0",
